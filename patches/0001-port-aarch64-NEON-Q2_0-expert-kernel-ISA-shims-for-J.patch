diff --git a/include/strata/portability.hpp b/include/strata/portability.hpp
new file mode 100644
index 0000000..25fce12
--- /dev/null
+++ b/include/strata/portability.hpp
@@ -0,0 +1,35 @@
+// strata-jetson port: minimal ISA portability shims.
+//
+// Upstream Strata targets x86-64 (AVX2 floor) plus CUDA.  This header gives the few
+// non-vector x86 helpers the engine core uses (_mm_pause spin hints, _mm_sfence store
+// fences) aarch64 equivalents so the core compiles unmodified on Jetson (ARMv8.2-A).
+// Vector kernels live in their own files and keep dedicated arch paths.
+#pragma once
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#define STRATA_X86 1
+#include <intrin.h>
+#include <immintrin.h>
+#define STRATA_PAUSE() _mm_pause()
+#define STRATA_SFENCE() _mm_sfence()
+#elif defined(__x86_64__) || defined(__i386__)
+#define STRATA_X86 1
+#include <immintrin.h>
+#define STRATA_PAUSE() _mm_pause()
+#define STRATA_SFENCE() _mm_sfence()
+#elif defined(__aarch64__)
+#define STRATA_ARM64 1
+#include <arm_acle.h>
+// yield: ARM's PAUSE equivalent (-encoded hint; low power draw while spinning).
+#define STRATA_PAUSE() __yield()
+// sfence: release-style store barrier; "dmb ishst" orders stores only, which is all
+// the call sites rely on (flushing packed results to shared/pinned memory).
+#define STRATA_SFENCE() __dmb(__ARM_ISHST)
+#else
+#define STRATA_PAUSE() \
+    do {               \
+    } while (0)
+#define STRATA_SFENCE() \
+    do {                \
+    } while (0)
+#endif

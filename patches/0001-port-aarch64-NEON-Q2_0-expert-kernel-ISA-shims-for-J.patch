+#if defined(STRATA_ARM64)
+/// f32 -> f16, round to nearest even (the MXCSR-default rounding `_mm_cvtps_ph` uses on x86).
+inline uint16_t f2h(float v) {
+    uint32_t x;
+    std::memcpy(&x, &v, 4);
+    const uint32_t sign = (x >> 16) & 0x8000u;
+    const int32_t exp = int32_t((x >> 23) & 0xFFu) - 127 + 15;
+    const uint32_t man = x & 0x7FFFFFu;
+    if (((x >> 23) & 0xFFu) == 0xFF) return uint16_t(sign | 0x7C00u | (man ? 0x200u : 0));  // inf / nan (coarse)
+    if (exp >= 0x1F) return uint16_t(sign | 0x7C00u);                                       // overflow -> inf
+    if (exp <= 0) {                                                                         // subnormal / zero
+        if (exp < -10) return uint16_t(sign);
+        const uint32_t m = man | 0x800000u;
+        const int shift = uint32_t(1 - exp) + 13 >= 32 ? 31 : (1 - exp) + 13;
+        uint32_t half = m >> shift;
+        const uint32_t rem = m << (32 - shift);
+        if ((rem > 0x80000000u) || (rem == 0x80000000u && (half & 1u))) ++half;             // nearest even
+        return uint16_t(sign | half);
+    }
+    uint32_t half = uint32_t(exp << 10) | (man >> 13);
+    const uint32_t rem = (man << 19);
+    if ((rem > 0x80000000u) || (rem == 0x80000000u && (half & 1u))) ++half;                 // nearest even
+    return uint16_t(sign | half);
+}
+#endif

+if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "(aarch64|arm64|ARM64)")
   add_executable(iq_avx1_parity src/kernels/cpu/iq_avx1_parity.cpp)
   target_link_libraries(iq_avx1_parity PRIVATE strata_kernels_cpu)
   if(STRATA_BUILD_TESTS)
     add_test(NAME iq_avx1_parity COMMAND iq_avx1_parity)
   endif()
+endif()  # strata-jetson: x86-only parity target
   # the AVX-2 Q8_K activation quantizer against ggml's, byte for byte (--bench: its time)
+if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "(aarch64|arm64|ARM64)")
   add_executable(q8k_quant_parity src/kernels/cpu/q8k_quant_parity.cpp)
   target_link_libraries(q8k_quant_parity PRIVATE strata_kernels_cpu)
   if(STRATA_BUILD_TESTS)
     add_test(NAME q8k_quant_parity COMMAND q8k_quant_parity)
     add_test(NAME q8k_quant_parity_avx COMMAND ${CMAKE_COMMAND} -E env STRATA_FORCE_ISA=avx $<TARGET_FILE:q8k_quant_parity>)
   endif()
+endif()  # strata-jetson: x86-only parity target
   set(_strata_mmq_types q2_0 iq2_xxs iq2_xs iq2_s iq3_xxs iq3_s iq4_nl iq4_xs q8_0)
   # #296: OrcaRouter Q4_K_S's Q5_0 experts (Q4_K and Q5_1 come with STRATA_MMQ_KQUANTS on CUDA, S5's branch)
   if(STRATA_ORCA_Q4KS_MMQ)
diff --git a/include/strata/portability.hpp b/include/strata/portability.hpp
index 25fce12..0aa2a0d 100644
--- a/include/strata/portability.hpp
+++ b/include/strata/portability.hpp
@@ -19,12 +19,11 @@
 #define STRATA_SFENCE() _mm_sfence()
 #elif defined(__aarch64__)
 #define STRATA_ARM64 1
-#include <arm_acle.h>
-// yield: ARM's PAUSE equivalent (-encoded hint; low power draw while spinning).
-#define STRATA_PAUSE() __yield()
+// yield: ARM's PAUSE equivalent (SLEEP hint; low power draw while spinning).
+#define STRATA_PAUSE() __asm__ __volatile__("yield" ::: "memory")
 // sfence: release-style store barrier; "dmb ishst" orders stores only, which is all
 // the call sites rely on (flushing packed results to shared/pinned memory).
-#define STRATA_SFENCE() __dmb(__ARM_ISHST)
+#define STRATA_SFENCE() __asm__ __volatile__("dmb ishst" ::: "memory")
 #else
 #define STRATA_PAUSE() \
     do {               \

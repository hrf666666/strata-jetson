diff --git a/src/kernels/cpu/arm_port_fallback.cpp b/src/kernels/cpu/arm_port_fallback.cpp
new file mode 100644
index 0000000..6d4e4ee
--- /dev/null
+++ b/src/kernels/cpu/arm_port_fallback.cpp
@@ -0,0 +1,56 @@
+// src/kernels/cpu/arm_port_fallback.cpp - strata-jetson port.
+//
+// Link-time stubs for the x86-only kernel translation units (iq_avx1/2/512.cpp, kq_avx1/2.cpp,
+// q2_avx1.cpp) that the aarch64 build excludes.  Every consumer gates on cpu_avx2_ok() /
+// cpu_avx1_ok() / cpu_avx512_ok() - all constant false on ARM - or on the *_supported()
+// predicates before reaching any of these, so the fast paths never run here: i-quant
+// experts and K/Q dots go through ggml-cpu's own NEON kernels.  The *_supported() stubs
+// return false so the multi-token dispatch table skips them by policy, not by accident.
+#include <cstdint>
+#include <cstdlib>
+
+namespace strata::kernels::cpu {
+
+// Portable env-probe from expert_layout.cpp (its x86 body sits behind the same TU's ARM guard).
+int iq256_gather_setting() {
+    static const int s = [] {
+        const char* v = std::getenv("STRATA_IQ256_GATHER");
+        if (v == nullptr || v[0] == '\0') return -1;
+        return std::atoi(v) != 0 ? 1 : 0;
+    }();
+    return s;
+}
+
+// No ISA-floor build flavor on ARM (the floor is an x86 older-CPU concept).
+const char* isa_floor_build() { return ""; }
+
+bool iq128_supported(int) noexcept { return false; }
+bool iq128_down_supported(int) noexcept { return false; }
+
+void iq128_gu_rows(int, const uint8_t*, size_t, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();  // gated by iq128_supported(), which is false
+}
+void iq128_down_rows(int, const uint8_t*, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();
+}
+void iq256_gu_rows(int, const uint8_t*, size_t, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();  // gated by cpu_avx2_ok()
+}
+void iq512_gu_rows(int, const uint8_t*, size_t, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();  // gated by cpu_avx512_ok()
+}
+void kq256_gu_rows(int, const uint8_t*, size_t, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();  // gated by cpu_avx2_ok() && STRATA_KQ256
+}
+void kq256_rows(int, const uint8_t*, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();
+}
+void iq4nl256_down_rows(const uint8_t*, size_t, int, const void* const*, int, float* const*, int, int) {
+    __builtin_unreachable();  // gated by cpu_avx2_ok()
+}
+void q8k_quant_avx1(const float*, void*, int64_t) { __builtin_unreachable(); }
+void q8k_quant_avx2(const float*, void*, int64_t) { __builtin_unreachable(); }
+void bf16_rows_dot_multi(const uint16_t*, int, int, const float*, int, float*) { __builtin_unreachable(); }
+void bf16_rows_dot_multi_avx1(const uint16_t*, int, int, const float*, int, float*) { __builtin_unreachable(); }
+
+}  // namespace strata::kernels::cpu
